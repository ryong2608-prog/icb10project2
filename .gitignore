# === Python 기본 컴파일/캐시 파일 파일 ===
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/




# === 가상 환경 (Virtual Environments) ===
.venv/
venv/
ENV/
env/
pip-selfcheck.json

# === Jupyter Notebook 관련 ===
.ipynb_checkpoints
*/.ipynb_checkpoints/*
# Jupyter Notebook의 임시 저장/체크포인트 파일
.ipynb_checkpoints/
# Jupyter 실행 시 자동 생성되는 로그 및 파일
.ipython/
.jupyter/
# Notebook 셀 실행 결과가 포함된 상태 등을 초기화하고 싶을 경우 대비
# (필요시 특정 노트북만 예외 처리 가능)

# === 데이터 및 대용량 파일 (데이터 분석용) ===
# 분석용 대용량 데이터는 Git에 업로드하지 않는 것이 원칙입니다.
data/
dataset/
datasets/
# 로컬 원천 데이터 파일 포맷들
*.csv
*.tsv
*.xlsx
*.xls
*.xml
*.json
# 대용량/바이너리 데이터 포맷
*.parquet
*.feather
*.h5
*.hdf5
*.pickle
*.pkl
*.npy
*.npz
*.dta
*.sav
*.sqlite
*.db

# 예외 처리: 만약 데이터 폴더 안의 구조는 유지하고 싶다면 아래 주석을 해제할 수 있습니다.
# !data/.gitkeep

# === 환경 변수 및 보안 정보 (Credential) ===
.env
.env.*
secrets.json
accounts.json
*.pem
*.key

# === IDE 설정 및 시스템 파일 ===
.vscode/
.idea/
.DS_Store
Thumbs.db

# === 모든 숨김 파일 및 폴더 제외 (단, .gitignore 제외) ===
.*
!.gitignore
